<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Immo Radar</title>
<meta name="description" content="Opportunites d'investissement locatif de la semaine, analysees a 360 degres : financement, cash-flow, fiscalite, courte duree, risques.">
<style>
:root{--bg:#f6f7f9;--card:#fff;--ink:#1b1f24;--muted:#5d6672;--line:#e3e6ea;--accent:#1f6feb;--ok:#1a7f37;--warn:#b35900;--bad:#c62828;--chip:#eef2f7}
:root:not([data-theme="light"]){color-scheme:light dark}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){--bg:#0f1115;--card:#171a21;--ink:#e6e8eb;--muted:#9aa4b2;--line:#2a2f3a;--accent:#539bf5;--ok:#3fb950;--warn:#e3a13a;--bad:#f0616d;--chip:#222734}}
:root[data-theme="dark"]{--bg:#0f1115;--card:#171a21;--ink:#e6e8eb;--muted:#9aa4b2;--line:#2a2f3a;--accent:#539bf5;--ok:#3fb950;--warn:#e3a13a;--bad:#f0616d;--chip:#222734}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif}
.wrap{max-width:1400px;margin:0 auto;padding:20px 16px}
h1{font-size:24px;margin:0 0 4px}.sub{color:var(--muted);margin:0 0 16px}
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:16px}
.kpi{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px}.kpi b{display:block;font-size:22px}.kpi span{color:var(--muted);font-size:13px}
.filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}
.filters input,.filters select{padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:var(--card);color:var(--ink);font-size:14px}
table{width:100%;border-collapse:collapse;background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden;font-size:14px}
th,td{padding:9px 10px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}th{cursor:pointer;color:var(--muted);font-weight:600;white-space:nowrap;background:var(--chip)}
tr.row:hover{background:var(--chip);cursor:pointer}
.score{display:inline-block;min-width:44px;text-align:center;padding:3px 7px;border-radius:999px;font-weight:700;color:#fff}
.s-hi{background:var(--ok)}.s-mid{background:var(--warn)}.s-lo{background:var(--bad)}
.pos{color:var(--ok);font-weight:600}.neg{color:var(--bad);font-weight:600}
.tag{display:inline-block;background:var(--chip);border-radius:6px;padding:1px 6px;font-size:12px;margin:1px 2px 1px 0}
.detail{display:none;background:var(--bg)}.detail td{padding:14px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px}
.box{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:12px}.box h4{margin:0 0 8px;font-size:14px;color:var(--muted);text-transform:uppercase;letter-spacing:.03em}
.box table{font-size:13px;border:0}.box td,.box th{padding:4px 6px}
ul{margin:4px 0 0 18px;padding:0}li{margin:2px 0}
.flag{color:var(--bad)}.fort{color:var(--ok)}
.tablewrap{overflow-x:auto;border-radius:10px}
.hyp{margin-top:20px;color:var(--muted);font-size:13px}
details summary{cursor:pointer;font-weight:600}
a{color:var(--accent)}
@media (max-width:800px){.hide-m{display:none}}
</style>
</head>
<body>
<div class="wrap">
<h1>Immo Radar</h1>
<p class="sub">Opportunites locatives de la semaine, analysees a 360 degres (financement, cash-flow, fiscalite, courte duree, risques). Genere le {{ genere_le }}.</p>
<div class="kpis" id="kpis"></div>
<div class="filters">
  <input id="q" placeholder="Rechercher (ville, titre, CP)">
  <select id="region"><option value="">Toutes les regions</option><option value="nord">Nord et Pas-de-Calais</option><option value="idf">Ile-de-France</option><option value="autre">Autres</option></select>
  <select id="ville"><option value="">Toutes les villes</option></select>
  <select id="cf"><option value="">Tous cash-flows</option><option value="pos">Autofinance (LD)</option><option value="cd">Autofinance (courte duree)</option></select>
  <select id="dpe"><option value="">Tous DPE</option><option value="ABCD">A a D</option><option value="E">E</option><option value="FG">F ou G</option></select>
  <select id="mode"><option value="">Tous modes de vente</option><option value="classique">Annonces classiques</option><option value="enchere_judiciaire">Encheres judiciaires</option><option value="vente_interactive">Ventes interactives notaires</option><option value="cession_etat">Biens de l'Etat</option></select>
  <label><input type="checkbox" id="new"> Nouvelles cette semaine</label>
</div>
<div class="tablewrap"><table id="t">
<thead><tr>
<th data-k="score">Score</th><th data-k="ville">Ville</th><th>Bien</th><th data-k="prix">Prix</th><th data-k="pm2" class="hide-m">EUR/m2 vs DVF</th>
<th data-k="rb" class="hide-m">Rdt brut</th><th data-k="cfld">CF LD/mois</th><th data-k="cfcd" class="hide-m">CF CD/mois</th><th class="hide-m">Signaux</th>
</tr></thead>
<tbody id="tb"></tbody>
</table></div>
<div class="hyp">
<details><summary>Hypotheses du modele</summary><pre id="hyp"></pre></details>
<p>Donnees : Bien'ici et notaires (annonces), Licitor (encheres judiciaires), immo-interactif (ventes notariales interactives), cessions.immobilier-etat.gouv.fr (biens de l'Etat), Carte des loyers 2025 (DHUP), DVF geolocalisees (DGFiP), Inside Airbnb, reglementation communale maintenue dans le depot. Estimations indicatives, a valider avant toute offre.</p>
</div>
</div>
<script id="data" type="application/json">{{ payload_json | safe }}</script>
<script>
const D=JSON.parse(document.getElementById('data').textContent);
const eur=v=>v==null?'':Math.round(v).toLocaleString('fr-FR')+' EUR';
const pct=v=>v==null?'':(v*100).toFixed(1).replace('.',',')+' %';
const num=v=>v==null?'':Math.round(v).toLocaleString('fr-FR');
const cls=s=>s>=75?'s-hi':s>=55?'s-mid':'s-lo';
const sgn=v=>v==null?'':`<span class="${v>=0?'pos':'neg'}">${v>=0?'+':''}${num(v)}</span>`;
const rows=D.opportunites.map((o,i)=>{const l=o.listing,m=o.market,r=o.resume;const pm2=l.surface?l.prix/l.surface:null;
 const cp=String(l.code_postal||'');const region=/^(59|62)/.test(cp)?'nord':/^(75|77|78|91|92|93|94|95)/.test(cp)?'idf':'autre';return {i,o,region,score:o.score.total,ville:l.ville,prix:l.prix,pm2,dvf:m.prix_m2_dvf_median,rb:r.rendement_brut,cfld:r.cashflow_ld_apres_impot,cfcd:r.cd_faisable?r.cashflow_cd_apres_impot:null,dpe:(l.dpe||'').toUpperCase(),nouvelle:!!(o.etat&&o.etat.nouvelle)}});
let sortK='score',sortDir=-1;
const kp=document.getElementById('kpis');const S=D.stats;
kp.innerHTML=[[S.annonces_analysees,'annonces analysees'],[S.publiees,'opportunites retenues'],[S.autofinancees_ld,'autofinancees en longue duree'],[S.autofinancees_cd,'autofinancees en courte duree'],[S.villes,'villes scannees']].map(([v,t])=>`<div class="kpi"><b>${v??0}</b><span>${t}</span></div>`).join('');
const vs=document.getElementById('ville');[...new Set(rows.map(r=>r.ville))].sort().forEach(v=>{const o=document.createElement('option');o.value=v;o.textContent=v;vs.appendChild(o)});
document.getElementById('hyp').textContent=JSON.stringify(D.hypotheses,null,1);
function detail(o){const l=o.listing,m=o.market,p=o.plan,r=o.resume;
 const sc=o.scenarios.map(s=>{const a=o.analyses[s.nom];return `<tr><td><b>${s.nom}</b>${s.faisable===false?' <span class="flag">(contraint)</span>':''}</td><td>${eur(s.loyer_mensuel_brut)}/mois</td><td>${pct(s.rendement_brut)}</td><td>${pct(s.rendement_net)}</td><td>${s.dscr.toFixed(2)}</td><td>${sgn(s.cashflow_mensuel_avant_impot)}</td><td>${a.meilleur_regime}</td><td>${sgn(a.meilleur_cashflow_mensuel)}</td></tr>`}).join('');
 const fisc=Object.values(o.analyses).map(a=>`<tr><td><b>${a.scenario}</b></td><td colspan="3">${a.resultats.map(x=>`${x.regime}${x.eligible?'':' (non eligible)'} : impot ${eur(x.impot_total)}/an, CF ${sgn(x.cashflow_mensuel_apres_impot)}/mois<br><small>${x.commentaire}</small>`).join('<br>')}</td></tr>`).join('');
 const comp=Object.entries(o.score.composantes).map(([k,v])=>`<tr><td>${k}</td><td>${v} / ${D.hypotheses.scoring.poids[k]}</td></tr>`).join('');
 const cd=o.scenarios.find(s=>s.nom==='courte_duree');
 return `<div class="grid">
 <div class="box"><h4>Bien</h4><p><a href="${l.url}" target="_blank" rel="noopener">${l.titre||'Annonce'}</a></p><p>${l.ville} ${l.code_postal} · ${l.surface} m2 · ${l.pieces} p. · DPE ${l.dpe||'?'} · ${l.annee_construction||''}</p><p>Travaux estimes : <b>${o.niveau_travaux}</b> (${eur(p.travaux)}) · ${l.loue_actuellement||l.occupe?'Occupe / loue':'Libre'} · ${l.prix_a_baisse?'Prix deja baisse':''}</p>${l.mode_vente&&l.mode_vente!=='classique'?`<p><b>${MODE[l.mode_vente]||l.mode_vente}</b> : ${l.prix_estime_note||''}</p>`:''}<p>Charges copro : ${l.charges_copro_annuelles?eur(l.charges_copro_annuelles)+'/an':'inconnues'} · Procedure : ${l.copro_en_procedure?'<span class="flag">oui</span>':'non'}</p><p>Publie le ${(l.date_publication||'').slice(0,10)} · Vu la premiere fois le ${o.etat?.premiere_vue||''}</p></div>
 <div class="box"><h4>Marche</h4><table><tr><td>Loyer de marche (carte des loyers)</td><td>${m.loyer_m2?m.loyer_m2.toFixed(1)+' EUR/m2 CC ('+m.loyer_nb_obs+' obs.)':'n/a'}</td></tr><tr><td>Mediane DVF ${m.dvf_annees}</td><td>${m.prix_m2_dvf_median?num(m.prix_m2_dvf_median)+' EUR/m2 ('+m.dvf_nb_ventes+' ventes, P25 '+num(m.prix_m2_dvf_p25)+', P75 '+num(m.prix_m2_dvf_p75)+')':'n/a'}</td></tr><tr><td>Prix/m2 annonce</td><td>${num(l.prix/l.surface)} EUR/m2</td></tr><tr><td>Courte duree</td><td>${m.courte_duree_faisable?'possible':'<span class="flag">contrainte</span>'} : ${m.courte_duree_note}</td></tr><tr><td>Donnees Airbnb</td><td>${m.str_adr?num(m.str_adr)+' EUR/nuit, '+pct(m.str_occupation)+' occ. ('+m.str_nb_annonces+' logements, '+m.str_source+')':'heuristique par categorie de ville'}</td></tr><tr><td>Encadrement des loyers</td><td>${m.encadrement_loyers?'<span class="flag">oui</span>':'non'}</td></tr></table></div>
 <div class="box"><h4>Financement</h4><table><tr><td>Prix negocie (cible)</td><td>${eur(p.prix_achat)}</td></tr><tr><td>Frais de notaire</td><td>${eur(p.frais_notaire)}</td></tr><tr><td>Travaux + ameublement</td><td>${eur(p.travaux+p.ameublement)}</td></tr><tr><td>Cout total</td><td><b>${eur(p.cout_total)}</b></td></tr><tr><td>Apport</td><td>${eur(p.apport)}</td></tr><tr><td>Emprunt ${p.duree_ans} ans a ${pct(p.taux)}</td><td>${eur(p.capital_emprunte)}</td></tr><tr><td>Mensualite assurance comprise</td><td><b>${eur(p.mensualite_totale)}</b></td></tr><tr><td>Interets annee 1</td><td>${eur(p.interets_annee_1)}</td></tr>${o.taux_effort!=null?`<tr><td>Taux d'effort HCSF</td><td>${pct(o.taux_effort)}</td></tr>`:''}</table></div>
 <div class="box" style="grid-column:1/-1"><h4>Scenarios d'exploitation</h4><table><tr><th>Scenario</th><th>Revenu</th><th>Rdt brut</th><th>Rdt net</th><th>DSCR</th><th>CF avant impot</th><th>Meilleur regime</th><th>CF apres impot</th></tr>${sc}</table>${cd?`<p><small>Courte duree : ${num(cd.hypotheses.adr)} EUR/nuit x ${cd.hypotheses.nuits_louees} nuits (${pct(cd.hypotheses.occupation)}), source ${cd.hypotheses.source}. Charges : ${Object.entries(cd.detail_charges).map(([k,v])=>k+' '+num(v)).join(', ')}.</small></p>`:''}</div>
 <div class="box" style="grid-column:1/-1"><h4>Fiscalite comparee (TMI ${pct(D.hypotheses.fiscalite.tmi)})</h4><table>${fisc}</table></div>
 <div class="box"><h4>Score ${o.score.total} : ${o.score.verdict}</h4><table>${comp}</table></div>
 <div class="box"><h4>Points forts</h4><ul>${o.score.points_forts.map(x=>`<li class="fort">${x}</li>`).join('')||'<li>aucun</li>'}</ul><h4 style="margin-top:10px">Red flags</h4><ul>${o.score.red_flags.map(x=>`<li class="flag">${x}</li>`).join('')||'<li>aucun</li>'}</ul></div>
 <div class="box"><h4>Checklist avant offre</h4><ul>${o.checklist.map(x=>`<li>${x}</li>`).join('')}</ul></div>
 </div>`}
const MODE={enchere_judiciaire:'encheres',vente_interactive:'vente interactive',cession_etat:'bien de l\'Etat'};
function render(){const q=document.getElementById('q').value.toLowerCase(),v=vs.value,rg=document.getElementById('region').value,cf=document.getElementById('cf').value,dp=document.getElementById('dpe').value,nw=document.getElementById('new').checked,md=document.getElementById('mode').value;
 let rs=rows.filter(r=>(!q||(r.ville+' '+r.o.listing.titre+' '+r.o.listing.code_postal).toLowerCase().includes(q))&&(!rg||r.region===rg)&&(!v||r.ville===v)&&(!md||(r.o.listing.mode_vente||'classique')===md)&&(cf!=='pos'||r.cfld>=0)&&(cf!=='cd'||r.cfcd>=0)&&(!dp||(dp==='ABCD'?'ABCD'.includes(r.dpe)&&r.dpe:dp==='E'?r.dpe==='E':'FG'.includes(r.dpe)&&r.dpe))&&(!nw||r.nouvelle));
 rs.sort((a,b)=>{const x=a[sortK]??-1e18,y=b[sortK]??-1e18;return typeof x==='string'?sortDir*x.localeCompare(y):sortDir*(x-y)});
 document.getElementById('tb').innerHTML=rs.map(r=>{const l=r.o.listing,m=r.o.market,e=r.o.etat||{};const dec=r.dvf?1-r.pm2/r.dvf:null;
 return `<tr class="row" data-i="${r.i}"><td><span class="score ${cls(r.score)}">${r.score}</span></td><td>${l.ville}<br><small>${l.code_postal}</small></td><td><a href="${l.url}" target="_blank" rel="noopener">${(l.titre||'Annonce').slice(0,70)}</a><br><small>${l.surface} m2 · ${l.pieces} p. · DPE ${l.dpe||'?'} · ${r.o.niveau_travaux}</small></td><td>${eur(l.prix)}${l.mode_vente&&l.mode_vente!=='classique'?`<br><small>${MODE[l.mode_vente]||l.mode_vente}${l.mise_a_prix?' : mise a prix '+eur(l.mise_a_prix):''}${l.date_vente?' · '+l.date_vente:''}</small>`:''}${e.baisse_prix_pct>0?`<br><small class="pos">-${pct(e.baisse_prix_pct)} depuis la 1re vue</small>`:''}</td><td class="hide-m">${num(r.pm2)}${dec!=null?`<br><small class="${dec>=0?'pos':'neg'}">${dec>=0?'-':'+'}${pct(Math.abs(dec))} vs DVF</small>`:''}</td><td class="hide-m">${pct(r.rb)}</td><td>${sgn(r.cfld)}<br><small>${r.o.resume.meilleur_scenario||''} · ${r.o.resume.meilleur_regime||''}</small></td><td class="hide-m">${r.cfcd!=null?sgn(r.cfcd):'<small>contrainte</small>'}</td><td class="hide-m">${r.nouvelle?'<span class="tag">nouveau</span>':''}${l.loue_actuellement?'<span class="tag">loue</span>':''}${l.prix_a_baisse?'<span class="tag">prix baisse</span>':''}${r.o.score.red_flags.length?`<span class="tag flag">${r.o.score.red_flags.length} alerte(s)</span>`:''}</td></tr><tr class="detail" id="d${r.i}"><td colspan="9">${detail(r.o)}</td></tr>`}).join('');}
document.querySelectorAll('th[data-k]').forEach(th=>th.onclick=()=>{const k=th.dataset.k;if(sortK===k)sortDir*=-1;else{sortK=k;sortDir=k==='ville'?1:-1}render()});
['q','region','ville','cf','dpe','new','mode'].forEach(id=>document.getElementById(id).addEventListener('input',render));
document.getElementById('tb').addEventListener('click',e=>{const tr=e.target.closest('tr.row');if(!tr||e.target.closest('a'))return;const d=document.getElementById('d'+tr.dataset.i);d.style.display=d.style.display==='table-row'?'none':'table-row'});
render();
</script>
</body>
</html>
